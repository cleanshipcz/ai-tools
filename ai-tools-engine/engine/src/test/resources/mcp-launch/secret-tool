#!@INTERPRETER@
# Test double of libsecret's secret-tool, placed first on the PATH of the launcher so that no test reaches a real keyring.
# The launcher starts it with nearly no environment, so the test installs it with @STATE@ replaced by its state directory and @TOOLS@ by a directory holding awk, cat and sleep.
# @INTERPRETER@ is the shell under test with the options of the launcher's #! line.
#   calls.log      every call is appended: a line "call <process id>" and one line "arg <argument>" per argument
#   environ/<process id>-secret-tool   the environment of the call exactly as the kernel handed it over (/proc/<pid>/environ), before this script's shell exported anything
#   behaviour      optional; "service-error" fails like an unreachable service, "hang" never answers, "ignore-term" never answers and ignores the stop signal, "killed" dies by SIGKILL, "drain-stdin" reads standard input to its end and then finds nothing
#   entries/<NAME> the value stored for the variable NAME, byte for byte; a missing file means "no entry"
set -u
state='@STATE@'
tools='@TOOLS@'

{
    printf 'call %s\n' "$$"
    for argument in "$@"; do
        printf 'arg %s\n' "$argument"
    done
} >>"$state/calls.log"
"$tools/cat" "/proc/$$/environ" >"$state/environ/$$-secret-tool"

behaviour=normal
if [ -f "$state/behaviour" ]; then
    behaviour=$("$tools/cat" "$state/behaviour")
fi

case $behaviour in
    service-error)
        # The exact text and exit code of secret-tool 0.20.4 when the bus address points nowhere.
        printf 'secret-tool: Could not connect: No such file or directory\n' >&2
        exit 1
        ;;
    hang)
        # exec keeps one process, so the time limit of the launcher ends the whole lookup.
        exec "$tools/sleep" 30
        ;;
    ignore-term)
        # An ignored signal stays ignored across exec, so only SIGKILL ends this lookup.
        trap '' TERM
        exec "$tools/sleep" 30
        ;;
    killed)
        kill -9 "$$"
        ;;
    drain-stdin)
        "$tools/cat" >/dev/null
        exit 1
        ;;
esac

# Anything but the documented lookup is a test failure, reported the way secret-tool reports a usage error.
if [ "$#" -ne 5 ] || [ "$1" != lookup ] || [ "$2" != service ] || [ "$3" != ai-tools-mcp ] || [ "$4" != variable ]; then
    printf 'fake secret-tool: unexpected arguments\n' >&2
    exit 2
fi

if [ -f "$state/entries/$5" ]; then
    exec "$tools/cat" "$state/entries/$5"
fi
# secret-tool exits 1 without a message when no item matches.
exit 1
