{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cleanshipcz/ai-tools/schemas/feature.schema.json",
  "title": "Feature Manifest",
  "description": "Schema for feature-specific context and instructions. Aligned with FeatureManifest.kt data class.",
  "type": "object",
  "required": ["id", "description", "prompt", "metadata"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique kebab-case identifier for the feature"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Brief description of the feature"
    },
    "prompt": {
      "type": "string",
      "minLength": 10,
      "description": "Feature implementation instructions and context"
    },
    "context": {
      "type": "object",
      "properties": {
        "overview": {
          "type": "string",
          "description": "Feature overview and purpose"
        },
        "architecture": {
          "type": "string",
          "description": "Architecture and design notes"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Feature dependencies (other features, libraries)"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Relevant file paths for this feature"
        }
      },
      "description": "Contextual information about the feature"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of acceptance criteria the feature must satisfy"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Hard boundaries and limitations for the feature"
    },
    "metadata": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version (semver), start at 1.0.0"
        },
        "author": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date"
        },
        "updated": {
          "type": "string",
          "format": "date"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "description": "Feature metadata including version, author, dates, and tags"
    }
  }
}
