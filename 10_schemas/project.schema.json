{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cleanshipcz/ai-tools/schemas/project.schema.json",
  "title": "Project Manifest",
  "description": "Schema for project-specific configuration manifests. Aligned with ProjectManifest.kt data class.",
  "type": "object",
  "required": ["id", "description", "metadata", "context", "deploy"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique kebab-case identifier for the project"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Brief description of the project"
    },
    "context": {
      "type": "object",
      "required": ["documentation"],
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Project-specific rules"
        },
        "overview": {
          "type": "string",
          "description": "Detailed project overview and background"
        },
        "documentation": {
          "type": "object",
          "properties": {
            "readme": {
              "type": "string",
              "description": "Path to README file"
            },
            "per_topic": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "description": "Categorized documentation references (e.g., main_docs: { prompts: path })"
            },
            "additional": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "Path to the documentation file"
                  },
                  "description": {
                    "type": "string",
                    "description": "Description of the documentation"
                  }
                }
              },
              "description": "Additional documentation items with path and description"
            }
          },
          "description": "Project documentation references"
        }
      },
      "description": "Contextual information about the project"
    },
    "deploy": {
      "type": "object",
      "required": ["directory"],
      "properties": {
        "directory": {
          "type": "string",
          "description": "Target directory for deployment"
        },
        "replace": {
          "type": "boolean",
          "default": false,
          "description": "Whether to replace existing files on deployment"
        },
        "prompts": {
          "type": "object",
          "properties": {
            "filter": {
              "$ref": "#/definitions/projectFilter"
            }
          },
          "description": "Prompt filtering configuration"
        },
        "agents": {
          "type": "object",
          "properties": {
            "filter": {
              "$ref": "#/definitions/projectFilter"
            }
          },
          "description": "Agent filtering configuration"
        },
        "features": {
          "type": "object",
          "properties": {
            "filter": {
              "$ref": "#/definitions/projectFilter"
            }
          },
          "description": "Feature filtering configuration"
        },
        "rulesets": {
          "type": "object",
          "properties": {
            "filter": {
              "$ref": "#/definitions/projectFilter"
            }
          },
          "description": "Ruleset filtering configuration"
        }
      },
      "description": "Deployment configuration"
    },
    "metadata": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version (semver), start at 1.0.0"
        },
        "author": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date"
        },
        "updated": {
          "type": "string",
          "format": "date"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "description": "Project metadata including version, author, dates, and tags"
    }
  },
  "definitions": {
    "projectFilter": {
      "description": "Filter configuration using one of three strategies: tags, whitelist, or blacklist",
      "oneOf": [
        {
          "type": "object",
          "required": ["tags"],
          "properties": {
            "tags": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Filter by matching tags"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["whitelist"],
          "properties": {
            "whitelist": {
              "type": "object",
              "required": ["ids"],
              "properties": {
                "ids": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Only include these IDs"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["blacklist"],
          "properties": {
            "blacklist": {
              "type": "object",
              "required": ["ids"],
              "properties": {
                "ids": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Exclude these IDs"
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
