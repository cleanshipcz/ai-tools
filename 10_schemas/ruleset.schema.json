{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cleanshipcz/ai-tools/schemas/ruleset.schema.json",
  "title": "Ruleset Manifest",
  "description": "Schema for reusable rulesets. Aligned with RulesetManifest.kt data class.",
  "type": "object",
  "required": ["id", "description", "metadata"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique kebab-case identifier prefixed by domain (e.g., coding-security, testing-unit)"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Description of the ruleset's purpose and scope"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 500
      },
      "description": "List of specific, actionable rules. Each rule should be independently verifiable."
    },
    "metadata": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version (semver), start at 1.0.0"
        },
        "author": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date"
        },
        "updated": {
          "type": "string",
          "format": "date"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "description": "Ruleset metadata including version, author, dates, and tags"
    }
  }
}
