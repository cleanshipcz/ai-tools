{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cleanshipcz/ai-tools/schemas/prompt.schema.json",
  "title": "Prompt Manifest",
  "description": "Schema for atomic prompt manifests with metadata and variables. Aligned with PromptManifest.kt data class.",
  "type": "object",
  "required": ["id", "description", "content", "metadata"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique kebab-case identifier for the prompt (e.g., manifests-create-agent)"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Clear description of what the prompt does"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$",
            "description": "Variable name in snake_case"
          },
          "required": {
            "type": "boolean",
            "default": true,
            "description": "Whether this variable is required (defaults to true)"
          },
          "description": {
            "type": "string",
            "description": "Description of the variable"
          }
        }
      },
      "description": "Variables that can be interpolated in the prompt using {{variable}} Mustache syntax"
    },
    "rulesets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of ruleset IDs to compose into this prompt"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 500
      },
      "description": "Inline rules or constraints specific to this prompt"
    },
    "content": {
      "type": "string",
      "description": "The prompt content/template. Use {{variable}} for Mustache-style interpolation."
    },
    "outputs": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": ["markdown", "json", "yaml", "code", "text"],
          "description": "Expected output format"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Example outputs"
        }
      },
      "description": "Output format specifications"
    },
    "metadata": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version (semver), start at 1.0.0"
        },
        "author": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date"
        },
        "updated": {
          "type": "string",
          "format": "date"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "description": "Prompt metadata including version, author, dates, and tags"
    }
  }
}
